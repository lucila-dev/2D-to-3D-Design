# Copy to .env and fill in values. Never commit the real .env file.

# fal.ai — image/sketch to 3D (https://fal.ai/dashboard/keys)
FAL_KEY=

# MetaPerson / Avatar SDK — character creator (Ready Player Me replacement)
# Create an app at https://accounts.avatarsdk.com/ → developer credentials
METAPERSON_CLIENT_ID=
METAPERSON_CLIENT_SECRET=

# VRoid Hub API — import characters you edited in VRoid Studio
# https://hub.vroid.com/oauth/applications
# Redirect URI on VRoid must EXACTLY match VROID_REDIRECT_URI (use the web URL, not sample-vroidsdk-app://)
VROID_CLIENT_ID=
VROID_CLIENT_SECRET=
VROID_REDIRECT_URI=http://localhost:5173/api/vroid/callback
VROID_HUB_URL=https://hub.vroid.com
VROID_SCOPE=default

